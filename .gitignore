# ==========================================================
# Smart Home Monitoring & Control System
# Keep this repo clean — supervisors inspect it.
# Rule: only source code, config templates, and the final
# technical report belong in git. Nothing else.
# ==========================================================

# --- Internal team planning / scratch (NEVER commit) ---
_planning/
_scratch/
notes/
TODO.md
*.local.md

# --- Course handouts & supplied material (not our work) ---
docs/*.pdf
docs/*.docx
docs/*.pptx

# --- Secrets (real ones — leaking these is a security issue) ---
*serviceAccount*.json
*service-account*.json
*firebase-adminsdk*.json
.env
.env.*
!.env.example

# --- Flutter / Dart ---
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
*.g.dart.bak
pubspec.lock.bak
coverage/

# --- Android ---
android/.gradle/
# Kotlin 2.x writes per-session build state here; it is regenerated every build.
android/.kotlin/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/
android/key.properties
*.jks
*.keystore
*.apk
*.aab

# --- iOS (in case anyone opens it on a Mac) ---
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
*.xcworkspace/xcuserdata/

# --- Node (simulator + safety worker) ---
node_modules/
npm-debug.log*
yarn-error.log*
dist/
.vite/

# --- Firebase ---
.firebase/
firebase-debug.log*
firestore-debug.log*
database-debug.log*
ui-debug.log*
*.log

# --- Editors / OS ---
.idea/
.vscode/*
!.vscode/extensions.json
*.iml
.DS_Store
Thumbs.db
desktop.ini

# --- AI assistant artefacts ---
.claude/
CLAUDE.md
.cursor/
.aider*

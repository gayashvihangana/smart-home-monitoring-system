# Copy to .env and fill in. NEVER commit .env — .gitignore blocks it.

# Realtime Database URL, from Firebase Console > Realtime Database
# Looks like: https://<project-id>-default-rtdb.<region>.firebasedatabase.app
FIREBASE_DB_URL=

# Absolute path to the service-account JSON.
# Firebase Console > Project settings > Service accounts > Generate new private key.
# Keep this file OUTSIDE the repo. It is a real credential — leaking it gives
# full admin access to the database.
GOOGLE_APPLICATION_CREDENTIALS=C:/keys/shms-adminsdk.json

# The home all devices belong to. Leave as-is unless you have a reason to change it.
HOME_ID=home1

# Firebase Auth UID of the account that owns the home.
# Unknown until the account exists — create it in Firebase Console > Authentication
# > Users (or register in the app) and copy the UID from there.
OWNER_UID=

# Every other UID admitted to the home, comma-separated: the other developers'
# accounts and the simulator's device account (simulator/sim-credentials.js).
# The owner is added automatically, so it does not need repeating here.
#
# seed.js OVERWRITES meta/members from this list, and the security rules admit
# nobody else — so a UID missing here is locked out at the next seed.
MEMBER_UIDS=
